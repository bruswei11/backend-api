# Copiar este archivo como ".env" y completar. NUNCA subir el .env a Internet ni compartirlo.

# Contraseña de la base de datos (inventá una larga).
DB_PASSWORD=cambiar-por-una-clave-larga

# Clave para firmar las sesiones: al menos 32 caracteres al azar.
# Se puede generar en PowerShell con:  -join ((48..57)+(97..102) | Get-Random -Count 64 | % {[char]$_})
JWT_SECRET=cambiar-por-64-caracteres-al-azar

# true = carga usuarios y estudiantes INVENTADOS para probar (solo si la base está vacía).
# Para uso real con estudiantes: false.
APP_DATOS_DEMO=true
APP_DEMO_PASSWORD=Demo2026!

# Puerto de la máquina donde se publica el servidor.
PUERTO=8080
